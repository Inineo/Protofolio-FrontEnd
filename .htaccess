<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /Public/

# 1. Hilangkan ekstensi .html jika diakses langsung (Redirect 301 ke Clean URL)
# /all-projects.html -> /projects
RewriteCond %{THE_REQUEST} \s/+(?:Public/)?all-projects(?:\.html)?[\s?] [NC]
RewriteRule ^all-projects(?:\.html)?$ projects [R=301,L]

# /project-detail.html?id=123 -> /project/123
RewriteCond %{THE_REQUEST} \s/+(?:Public/)?project-detail(?:\.html)?\?id=([0-9]+)[\s] [NC]
RewriteRule ^project-detail(?:\.html)?$ project/%1? [R=301,L]

# Hilangkan file .html umum lainnya jika ada
RewriteCond %{THE_REQUEST} \s/+(?:Public/)?([^.]+)\.html[\s?] [NC]
RewriteRule ^([^.]+)\.html$ $1 [R=301,L]


# 2. Internal Rewrite: Petakan Clean URL kembali ke file fisik asli
# /projects -> all-projects.html
RewriteRule ^projects/?$ all-projects.html [L,QSA]

# /project/123 -> project-detail.html?id=123
RewriteRule ^project/([0-9]+)/?$ project-detail.html?id=$1 [L,QSA]

# General fallback: nama file tanpa .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L,QSA]
</IfModule>
